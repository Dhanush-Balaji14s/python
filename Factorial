#while loop
n=int(input("Enter a number:"))
fact=1
while n>0:
      fact *= n
      n=n-1
print("Factorial: ",fact)

#for loop
n=int(input("Enter a number:"))
fact=1
for i in range(1,n+1):
    fact *= i
print("Factorial: ",fact)

#function
def fact(n):
    result=1
    for i in range(1,n+1):
        result *= i
    return result
num=int(input("Enter a number:"))
print(fact(num))

